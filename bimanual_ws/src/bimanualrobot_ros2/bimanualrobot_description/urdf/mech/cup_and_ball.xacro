        <geometry><box size="0.01 0.020616 0.2"/></geometry></collision>

    </link>

    <!-- Fixed joint attaching the cup to its parent link -->
    <joint name="${prefix}_cup_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_cup"/>
    </joint>

  </xacro:macro>
</robot>