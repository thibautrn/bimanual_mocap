<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cup_and_ball" params="prefix parent *origin">
    
    <!-- Cup pole (small cylinder under the cup) -->
    <link name="${prefix}_cup_pole">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0075" length="0.08"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0075" length="0.08"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <mass value="0.005"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0"
                 izz="0.000001"/>
      </inertial>
    </link>

    <!-- Cup bottom (flat cylinder) -->
    <link name="${prefix}_cup_bottom">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.01"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.01"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.0002"/>
      </inertial>
    </link>


    <!-- Cup wall +X -->
    <link name="${prefix}_cup_wall_x_plus">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.1 0.1"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.1 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.00001"/>
      </inertial>
    </link>

    <!-- Cup wall -X -->
    <link name="${prefix}_cup_wall_x_minus">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.1 0.1"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.1 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.00001"/>
      </inertial>
    </link>

    <!-- Cup wall +Y -->
    <link name="${prefix}_cup_wall_y_plus">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.005 0.1"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.005 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <!-- Cup wall -Y -->
    <link name="${prefix}_cup_wall_y_minus">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.005 0.1"/>
        </geometry>
        <material name="wood"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.005 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <!-- Mount cup pole to parent (end effector) -->
    <joint name="${prefix}_cup_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}_cup_pole"/>
    </joint>

    <!-- Attach cup bottom to pole (at z=0.08, centered in pole) -->
    <joint name="${prefix}_cup_bottom_joint" type="fixed">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <parent link="${prefix}_cup_pole"/>
      <child link="${prefix}_cup_bottom"/>
    </joint>


    <!-- Attach cup walls (centered at z=0.18, which is middle of 0.2m wall height) -->
    <joint name="${prefix}_cup_wall_x_plus_joint" type="fixed">
      <origin xyz="0.060 0 0.12" rpy="0 0 0"/>
      <parent link="${prefix}_cup_pole"/>
      <child link="${prefix}_cup_wall_x_plus"/>
    </joint>

    <joint name="${prefix}_cup_wall_x_minus_joint" type="fixed">
      <origin xyz="-0.060 0 0.12" rpy="0 0 0"/>
      <parent link="${prefix}_cup_pole"/>
      <child link="${prefix}_cup_wall_x_minus"/>
    </joint>

    <joint name="${prefix}_cup_wall_y_plus_joint" type="fixed">
      <origin xyz="0 0.060 0.12" rpy="0 0 0"/>
      <parent link="${prefix}_cup_pole"/>
      <child link="${prefix}_cup_wall_y_plus"/>
    </joint>

    <joint name="${prefix}_cup_wall_y_minus_joint" type="fixed">
      <origin xyz="0 -0.060 0.12" rpy="0 0 0"/>
      <parent link="${prefix}_cup_pole"/>
      <child link="${prefix}_cup_wall_y_minus"/>
    </joint>

  </xacro:macro>
</robot>